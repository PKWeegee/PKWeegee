{
    "0": {
        "34_0": {
            "lines": [
                "What a huge lake...",
                "Where's this god then?"
            ]
        },
        "38_0": {
            "lines": [
                "Could she maybe...?",
                "Ah whatever! Show yourself!"
            ]
        },
        "42_0": {
            "lines": [
                "Who is it that calls for me?"
            ]
        },
        "170_0": {
            "lines": [
                "Oh?",
                "And here I thought the shrine maiden herself would come..."
            ]
        },
        "174_0": {
            "lines": [
                "Why did she send you?"
            ]
        },
        "178_0": {
            "lines": [
                "I kinda...do this kind of work for her."
            ]
        },
        "186_0": {
            "lines": [
                "Thats funny. A youkai helping out the shrine?",
                "I suppose it does benefit you, doesn't it?"
            ]
        },
        "194_0": {
            "lines": [
                "Hey, I'm a human, through and through! I don't",
                "care about faith or whatever, I just want my shrine to be ok!"
            ]
        },
        "202_0": {
            "lines": [
                "You, not care about faith? You are filled to the brim",
                "with faith though. You gathered so much on your way here."
            ]
        },
        "210_0": {
            "lines": [
                "Normal humans can't gather faith like this."
            ]
        },
        "218_0": {
            "lines": [
                "Why is it that you're denying your true nature?",
                "What are you scared of?"
            ]
        },
        "226_0": {
            "lines": [
                "L-look, I'm human, ok?! I just gathered these green orbs."
            ]
        },
        "234_0": {
            "lines": [
                "You guys just threw your shrine on this mountain,",
                "and are causing Gensokyo's faith to go all over the place!"
            ]
        },
        "242_0": {
            "lines": [
                "You don't understand, do you?"
            ]
        },
        "250_0": {
            "lines": [
                "Like it or not...",
                "your faith is way too high right now."
            ]
        },
        "258_0": {
            "lines": [
                "Either give it up now...or I'll take it by force!"
            ]
        },
        "266_0": {
            "lines": [
                "I don't need this stupid faith!",
                "But if you really want to fight..."
            ]
        },
        "274_0": {
            "lines": [
                "Then I guess there's no other choice!",
                "Let's see if I can fight a god!"
            ]
        },
        "282_0": {
            "lines": [
                "A lowly youkai like you could never hope to beat me."
            ]
        },
        "290_0": {
            "lines": [
                "It's nothing personal,",
                "but you need to stop living in denial!"
            ]
        },
        "298_0": {
            "lines": [
                "Wake up to your true nature!"
            ]
        }
    }
}