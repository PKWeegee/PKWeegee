{
    "0": {
        "34_0": {
            "lines": [
                "This forest feels totally awful..."
            ]
        },
        "38_0": {
            "lines": [
                "Why is this miasma so strong here?"
            ]
        },
        "42_0": {
            "lines": [
                "My, my, you're still here?"
            ]
        },
        "110_0": {
            "lines": [
                "And I had just tried to turn you away."
            ]
        },
        "114_0": {
            "lines": [
                "Why?"
            ]
        },
        "122_0": {
            "lines": [
                "...Eh, forget about it. Anyway!",
                "My duty is to chase away lost humans."
            ]
        },
        "130_0": {
            "lines": [
                "Lost? Sorry, but I'm anything but lost. I've got a clear",
                "goal in mind. The youkai mountain, that is."
            ]
        },
        "138_0": {
            "lines": [
                "I see...",
                "But why do you want to go to the dangerous mountains?"
            ]
        },
        "146_0": {
            "lines": [
                "I've got my reasons. If you wanna fight, go for it."
            ]
        },
        "154_0": {
            "lines": [
                "But I'm a friend to humans...and youkai.",
                "I take their misfortunes and pass them on to the gods."
            ]
        },
        "162_0": {
            "lines": [
                "Would you like me to take on all of your tragedies?"
            ]
        },
        "170_0": {
            "lines": [
                "I've got too many. You'll get fat from that.",
                ""
            ]
        },
        "178_0": {
            "lines": [
                "I'll be the judge of that..."
            ]
        }
    },
    "1": {
        "30_0": {
            "lines": [
                "Your misfortunes run too deep for me..."
            ]
        },
        "34_0": {
            "lines": [
                "Tell me about it..."
            ]
        },
        "38_0": {
            "lines": [
                "Beyond here is the world of the gods."
            ]
        },
        "46_0": {
            "lines": [
                "It's no place for someone like you to go...",
                "You'll regret this."
            ]
        },
        "54_0": {
            "lines": [
                "I doubt a god will be of much trouble to me.",
                "Onwards to the Youkai Mountain!"
            ]
        }
    }
}